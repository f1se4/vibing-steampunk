# Tradebe build helpers for vibing-steampunk/vsp
# Usage:
#   make -f Makefile.tradebe           → show help
#   make -f Makefile.tradebe install   → build (with version info) + install to ~/bin/vsp
#   make -f Makefile.tradebe install-windows → build Windows amd64 + deploy to /mnt/c/bin/vsp/
#   make -f Makefile.tradebe clean     → remove temp artifacts

GO      := $(shell which go)
CMD_DIR := ./cmd/vsp/

# Version info embedded at build time (same pattern as upstream Makefile)
VERSION   ?= $(shell git describe --tags --always --dirty 2>/dev/null || echo "dev")
COMMIT    ?= $(shell git rev-parse --short HEAD 2>/dev/null || echo "unknown")
BUILDDATE ?= $(shell date -u +"%Y-%m-%dT%H:%M:%SZ")
LDFLAGS   := -ldflags "-s -w -X main.Version=$(VERSION) -X main.Commit=$(COMMIT) -X main.BuildDate=$(BUILDDATE)"

INSTALL_DIR        := $(HOME)/bin
WINDOWS_DEPLOY_DIR := /mnt/c/bin/vsp
TMP_BINARY         := /tmp/vsp_tradebe
TMP_WIN_BINARY     := /tmp/vsp_tradebe_win.exe

.PHONY: build install install-windows clean help

help: ## Show this help
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-20s\033[0m %s\n", $$1, $$2}'

build: ## Build for current platform (output: /tmp/vsp_tradebe)
	$(GO) build $(LDFLAGS) -o $(TMP_BINARY) $(CMD_DIR)
	@echo "Built: $(TMP_BINARY)  [$(VERSION) $(COMMIT)]"

install: build ## Build + install to ~/bin/vsp (macOS: ad-hoc signed)
	@mkdir -p $(INSTALL_DIR)
	cp $(TMP_BINARY) $(INSTALL_DIR)/vsp
	@if [ "$$(uname)" = "Darwin" ]; then \
		codesign --sign - --force --preserve-metadata=entitlements $(INSTALL_DIR)/vsp 2>/dev/null && echo "Signed: $(INSTALL_DIR)/vsp (ad-hoc)" || true; \
	fi
	@echo "Installed: $(INSTALL_DIR)/vsp"
	@$(INSTALL_DIR)/vsp version 2>/dev/null || $(INSTALL_DIR)/vsp --help 2>&1 | head -1 || true

install-windows: ## Build Windows amd64 + deploy to /mnt/c/bin/vsp/ (WSL only)
	GOOS=windows GOARCH=amd64 $(GO) build $(LDFLAGS) -o $(TMP_WIN_BINARY) $(CMD_DIR)
	@echo "Built: $(TMP_WIN_BINARY)  [$(VERSION) $(COMMIT)]"
	@mkdir -p $(WINDOWS_DEPLOY_DIR)
	cp $(TMP_WIN_BINARY) $(WINDOWS_DEPLOY_DIR)/vsp.exe
	@echo "Deployed: $(WINDOWS_DEPLOY_DIR)/vsp.exe"

clean: ## Remove temp build artifacts
	rm -f $(TMP_BINARY) $(TMP_WIN_BINARY)
